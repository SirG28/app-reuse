# Postgres local via Docker Compose (docker compose up -d):
# DATABASE_URL="postgresql://reuse:reuse@localhost:5432/reuse_web?schema=public"
# DIRECT_URL="postgresql://reuse:reuse@localhost:5432/reuse_web?schema=public"

# Postgres na nuvem (ex.: Neon) — DATABASE_URL usa o endpoint com pooler
# (para a aplicação em runtime) e DIRECT_URL usa o endpoint sem "-pooler"
# (necessário para o Prisma Migrate rodar DDL/locks corretamente).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require"
