generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) usada pelo Prisma Migrate — o endpoint
  // "-pooler" da Neon (PgBouncer, modo transaction) não suporta os locks
  // e prepared statements que as migrations precisam.
  directUrl = env("DIRECT_URL")
}

// Usuário da plataforma ReUse! (equivalente ao User de services/authService.ts no mobile)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  cep          String?
  cidade       String?
  estado       String?
  createdAt    DateTime @default(now())

  items    Item[]
  sessions Session[]
  comments Comment[]
}

// Item publicado para troca (equivalente ao Item de services/itemsService.ts no mobile)
model Item {
  id        String   @id @default(cuid())
  titulo    String
  descricao String
  troca     String
  imagem    String?
  whatsapp  String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments Comment[]
}

// Sessão de autenticação da versão web (o mobile usa AsyncStorage local; na web
// o estado de login precisa ser validado no servidor via cookie + tabela)
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Comentário de um usuário em um item publicado (área nova: detalhe do item)
model Comment {
  id        String   @id @default(cuid())
  conteudo  String
  createdAt DateTime @default(now())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Resposta a um comentário existente (ex.: o dono do item respondendo a
  // uma pergunta). Um nível só de profundidade: uma resposta não tem, ela
  // mesma, respostas.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
}
